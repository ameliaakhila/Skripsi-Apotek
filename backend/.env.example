# Stock Prediction Model Configuration

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_DEBUG=False

# Model Configuration
MODEL_PATH=model/stock_prediction_model.pkl
DATASET_PATH=dataset/prepared_data.csv

# Training Configuration
TEST_SIZE=0.2
RANDOM_STATE=42
CV_FOLDS=5

# Model Hyperparameters (CARD Method)
MAX_DEPTH=10
MIN_SAMPLES_SPLIT=5
MIN_SAMPLES_LEAF=2
CRITERION=squared_error

# Feature Selection
MIN_CORRELATION=0.05

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log

# Laravel Integration
LARAVEL_API_URL=http://localhost:8000
LARAVEL_EXPORT_PATH=../frontend/storage/training_data_prediksi_stok
